{
  "manifest_version": 3,
  "name": "LearnFlow 收藏同步",
  "version": "0.2.0",
  "description": "将小红书收藏夹中已加载的笔记一键同步到 LearnFlow。",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://xiaohongshu.com/*",
    "https://hujy-0525.github.io/learnflow-ai/*"
  ],
  "action": {
    "default_title": "同步到 LearnFlow",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*", "https://xiaohongshu.com/*"],
      "js": ["xhs-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://hujy-0525.github.io/learnflow-ai/*"],
      "js": ["learnflow-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
